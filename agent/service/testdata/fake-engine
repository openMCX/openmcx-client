#!/usr/bin/env python3
# A stand-in for mcx-client in the daemon tests: the MCData status keys and events the daemon
# reads, as the engine writes them. Besides the engine's own commands it takes test commands:
#   fake-sds <from> <disposition 0-3> <text>       a one-to-one SDS arrives
#   fake-group-sds <from> <group> <text>           a group SDS arrives
#   fake-file <from> <name>                        a one-to-one file offer arrives
#   fake-read <message ID>                         the recipient reports a sent message read
#   fake-emergency-sds <from> <text>               a one-to-one emergency SDS arrives
#   fake-forget <message ID>                       the engine drops a received message (its last 50)
#   fake-alias-outcome <outcome>                   the outcome of the next alias activations
#   fake-lose-alias <alias>                        another user takes the alias over
#   fake-speech <from> <ms>                        a talk burst is heard (media.speech_dir)
#   fake-floor-owner <MCPTT ID>|none               another user has the floor, or nobody
#   fake-revoke                                    the floor is revoked while the agent talks
#   fake-floor deny|grant                          the outcome of the next floor requests
#   fake-call-in private <MCPTT ID> | group        an MCPTT call to the agent, or of its group, is answered
#   fake-video-in private <MCVideo ID> | group     an MCVideo call to the agent, or of its group, is answered
# The MCPTT and MCVideo calls, the floor (a WAV is "spoken" for its duration) and transmission control are faked
# too, and the pictures written to mcvideo.live's FIFO counted. Configuration "fake": {"alias_outcome": "activated"
# | "refused" | ...}; a recipient or callee whose user part starts with "refuse" answers 403.
import hashlib, json, os, signal, sys, threading, uuid

config = sys.argv[sys.argv.index("--config") + 1]
cfg = json.load(open(config))
fifo, status_file = cfg["control_fifo"], cfg["status_file"]
fake = cfg.get("fake") or {}
st = {"registered": True, "authorized": True, "mcdata_authorized": True, "last_error": None,
      "mcdata_functional_aliases": [], "mcdata_fa_last_result": None, "mcdata_inbox": [], "mcdata_sent": [],
      "mcdata_notifications": [], "mcdata_files": [], "mcdata_file_notifications": [],
      "mcdata_fd_last_result": None,
      "call_state": "idle", "call_type": "", "call_group": "", "private_peer": "", "floor_control": True,
      "floor_owner": "", "floor_state": "NoPermission", "queued": False, "affiliated": True,
      "group_id": cfg.get("mcptt", {}).get("group_id", "sip:ops@example.org")}
if "mcvideo" in cfg:
    st.update({"mcvideo_authorized": True, "mcvideo_affiliated": True, "mcvideo_call_state": "idle",
               "mcvideo_transmitting": False, "mcvideo_selected_group": cfg["mcvideo"].get("group_id", "sip:ops@example.org")})
lock = threading.RLock()
talk = {"timer": None}


def save():
    with lock:
        save_locked()


def save_locked():
    tmp = status_file + ".tmp"
    json.dump(st, open(tmp, "w"))
    os.replace(tmp, status_file)


def event(kind, **detail):
    detail["event"] = kind
    print(json.dumps(detail), flush=True)


def failure(reason):
    st["last_error"] = reason
    event("client_error", reason=reason)


def find(key, mid):
    return next((m for m in st[key] if m["message_id"] == mid), None)


def unescape(text):
    """The engine's control_unescape: \\n a line break, \\t a tab, \\\\ a backslash."""
    out, i = [], 0
    while i < len(text):
        if text[i] == "\\" and i + 1 < len(text) and text[i + 1] in "nt\\":
            out.append({"n": "\n", "t": "\t", "\\": "\\"}[text[i + 1]])
            i += 2
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def options(rest):
    """The leading option words of sds and sds-reply: (disposition, escaped, the other words)."""
    disposition, escaped = 0, False
    while rest and rest[0] in ("delivery", "read", "both", "escaped"):
        if rest[0] == "escaped":
            escaped = True
        else:
            disposition = {"delivery": 1, "read": 2, "both": 3}[rest[0]]
        rest = rest[1:]
    return disposition, escaped, rest


def send_sds(target, disposition, text):
    mid = str(uuid.uuid4())
    refused = target.split(":", 1)[1].startswith("refuse")
    st["mcdata_sent"].append({"message_id": mid, "target": target, "text": text, "disposition": disposition,
                              "status": 403 if refused else 200})
    st["mcdata_last_result"] = {"message_id": mid, "status": 403 if refused else 200,
                                "warning": '403 mcdata.test "229 one-to-one target not allowed"' if refused else ""}
    event("mcdata_sds_sent", message_id=mid, request_type="one-to-one-sds", target=target, disposition=disposition)
    if disposition in (1, 3) and not refused:
        st["mcdata_notifications"].append({"from": target, "group": "", "type": 2, "message_id": mid})


def end_talk(kind="floor_released"):
    with lock:
        if talk["timer"]:
            talk["timer"].cancel()
            talk["timer"] = None
        if st["floor_state"] == "HasPermission" or kind == "floor_released":
            st["floor_state"] = "NoPermission"
            event("floor_released")
        save()


def wav_seconds(path):
    return max(os.path.getsize(path) - 44, 0) / 32000


def video_call(kind, peer="", transmit=False, mode=""):
    if peer.split(":", 1)[-1].startswith("refuse"):
        return event("mcvideo_call_ended", reason="403")
    st.update(mcvideo_call_state="active", mcvideo_call_type=kind, mcvideo_peer=peer, mcvideo_video_mode=mode,
              mcvideo_group="" if peer else st["mcvideo_selected_group"])
    event("mcvideo_call_active", group=st["mcvideo_group"])
    if transmit:
        st["mcvideo_transmitting"] = True
        event("mcvideo_transmission_granted", video_ssrc=1)


def read_pictures(path, size):
    """mcvideo.live: count the pictures written to the FIFO."""
    if not os.path.exists(path):
        os.mkfifo(path, 0o600)
    fd, total = os.open(path, os.O_RDWR), 0
    while True:
        total += len(os.read(fd, 1 << 16))
        with lock:
            st["mcvideo_live"] = {"pictures": total // size}
            save_locked()


def command(line):
    words = line.split()
    verb, rest = words[0], words[1:]
    if verb in ("call", "private") and st["call_state"] != "idle":
        failure("call requires affiliation and idle state")
    elif verb == "call":
        st.update(call_state="active", call_type="prearranged", call_group=st["group_id"], private_peer="")
        event("call_active", dialog="d1")
    elif verb == "private":
        if rest[0].split(":", 1)[1].startswith("refuse"):
            return event("call_disconnected", status=403, dialog="d1")
        st.update(call_state="active", call_type="private", call_group="", private_peer=rest[0])
        event("call_active", dialog="d1")
    elif verb == "hangup":
        end_talk()
        st.update(call_state="idle", call_type="", call_group="", private_peer="")
        event("call_disconnected", status=200, dialog="d1")
    elif verb == "ptt":
        if st["call_state"] != "active":
            return failure("PTT requires active call")
        if fake.get("floor") == "deny":
            st["last_floor_reject_cause"] = 1
            return event("floor_denied", reject_cause=1)
        st["floor_state"] = "HasPermission"
        event("floor_granted")
        talk["timer"] = threading.Timer(wav_seconds(rest[0]), end_talk)
        talk["timer"].start()
    elif verb == "release":
        end_talk()
    elif verb == "fake-call-in":
        private = rest[0] == "private"
        st.update(call_state="active", call_type="private" if private else "prearranged",
                  call_group="" if private else st["group_id"], private_peer=rest[1] if private else "")
        event("call_active", dialog="d1")
    elif verb == "fake-video-in":
        video_call("private" if rest[0] == "private" else "prearranged", rest[1] if rest[0] == "private" else "")
    elif verb == "fake-revoke":
        end_talk()
        event("floor_revoked")
    elif verb == "fake-floor":
        fake["floor"] = rest[0]
    elif verb == "fake-floor-owner":
        st["floor_owner"] = "" if rest[0] == "none" else rest[0]
    elif verb == "fake-speech":
        folder = cfg["media"]["speech_dir"]
        path = os.path.join(folder, "speech-" + str(uuid.uuid4()) + ".wav")
        samples = int(rest[1]) * 16
        header = b"RIFF" + (36 + 2 * samples).to_bytes(4, "little") + b"WAVEfmt " + (16).to_bytes(4, "little")
        header += (1).to_bytes(2, "little") + (1).to_bytes(2, "little") + (16000).to_bytes(4, "little")
        header += (32000).to_bytes(4, "little") + (2).to_bytes(2, "little") + (16).to_bytes(2, "little")
        open(path, "wb").write(header + b"data" + (2 * samples).to_bytes(4, "little") + b"\x01\x00" * samples)
        private = st["call_type"] == "private"
        event("speech_received", file=path, **{"from": rest[0]}, call_type=st["call_type"] or "prearranged",
              group="" if private else st["group_id"], peer=st["private_peer"], dialog="d1",
              duration_ms=int(rest[1]), ended="floor released")
    elif verb == "mcvideo-call":
        video_call("prearranged", transmit=rest[:1] == ["implicit"])
    elif verb == "mcvideo-private":
        video_call("private", rest[0])
    elif verb == "mcvideo-push":
        video_call("private", rest[0], True, "one-to-one video push")
    elif verb == "mcvideo-transmit":
        if st["mcvideo_call_state"] != "active":
            return failure("no MCVideo call")
        st["mcvideo_transmitting"] = True
        event("mcvideo_transmission_granted", video_ssrc=1)
    elif verb == "mcvideo-end":
        st["mcvideo_transmitting"] = False
        event("mcvideo_transmission_ended")
    elif verb == "mcvideo-hangup":
        st.update(mcvideo_call_state="idle", mcvideo_transmitting=False)
        event("mcvideo_call_ended", reason="hangup")
    elif verb == "mcdata-fa" and rest[0] == "activate":
        outcome = fake.get("alias_outcome", "activated")
        st["mcdata_fa_last_result"] = {"action": "activate", "aliases": rest[1:], "status": 200,
                                       "outcomes": {a: outcome for a in rest[1:]}}
        if outcome == "activated":
            st["mcdata_functional_aliases"] += rest[1:]
        event("mcdata_functional_alias_requested", action="activate", aliases=rest[1:])
    elif verb == "mcdata-fa" and rest[0] == "use":
        pass
    elif verb == "sds":
        disposition, escaped, rest = options(rest)
        text = line.split(rest[0], 1)[1].lstrip()  # the text as written, spaces kept
        send_sds(rest[0], disposition, unescape(text) if escaped else text)
    elif verb == "sds-reply":
        disposition, escaped, rest = options(rest)
        original = find("mcdata_inbox", rest[0]) if rest else None
        if original is None:
            return failure("usage: sds-reply [delivery|read|both] [escaped] <received message ID> <text>")
        text = line.split(rest[0], 1)[1].lstrip()
        send_sds(original["from"], disposition, unescape(text) if escaped else text)
    elif verb == "sds-display":
        received = find("mcdata_inbox", rest[0])
        if received is None:
            return failure("no received SDS message with that ID")
        received["displayed"] = True
    elif verb == "fd-send":
        mandatory = rest[0] == "mandatory"
        if mandatory:
            rest = rest[1:]
        target, path = rest
        if not os.path.isfile(path):
            return failure("file not found: " + path)
        mid = str(uuid.uuid4())
        st["mcdata_fd_last_result"] = {"message_id": mid, "status": 200}
        event("mcdata_file_sent", message_id=mid, request_type="one-to-one-fd", target=target,
              file_url="https://content/" + mid, bytes=os.path.getsize(path), mandatory=mandatory)
        st["mcdata_file_notifications"].append({"from": target, "group": "", "type": 1, "message_id": mid})
    elif verb in ("fd-accept", "fd-reject", "fd-defer"):
        offer = find("mcdata_files", rest[0])
        if offer is None:
            return failure("no file transfer with that ID")
        if verb == "fd-accept":
            folder = os.path.join(os.path.dirname(status_file), "downloads")
            os.makedirs(folder, exist_ok=True)
            data = b"contents of " + offer["name"].encode()
            path = os.path.join(folder, offer["name"])
            open(path, "wb").write(data)
            offer.update(state="downloaded", path=path, plain_bytes=len(data),
                         plain_sha256=hashlib.sha256(data).hexdigest())
        else:
            offer["state"] = {"fd-reject": "rejected", "fd-defer": "deferred"}[verb]
    elif verb == "fake-sds":
        mid = str(uuid.uuid4())
        st["mcdata_inbox"].append({"message_id": mid, "conversation_id": str(uuid.uuid4()), "in_reply_to": None,
                                   "from": rest[0], "group": "", "request_type": "one-to-one-sds",
                                   "disposition": int(rest[1]), "displayed": False, "functional_alias": "",
                                   "called_functional_alias": fake.get("called_alias", ""),
                                   "payloads": [{"content_type": 1, "text": " ".join(rest[2:]), "bytes": 1}]})
        event("mcdata_sds_received", message_id=mid, **{"from": rest[0]}, group="", disposition=int(rest[1]))
    elif verb == "fake-emergency-sds":
        mid = str(uuid.uuid4())
        st["mcdata_inbox"].append({"message_id": mid, "conversation_id": str(uuid.uuid4()), "from": rest[0],
                                   "group": "", "request_type": "one-to-one-sds", "disposition": 0,
                                   "displayed": False, "emergency": True, "used_priority": 9,
                                   "authenticated": True,
                                   "payloads": [{"content_type": 1, "text": " ".join(rest[1:]), "bytes": 1}]})
    elif verb == "fake-group-sds":
        mid = str(uuid.uuid4())
        st["mcdata_inbox"].append({"message_id": mid, "conversation_id": str(uuid.uuid4()), "from": rest[0],
                                   "group": rest[1], "request_type": "group-sds", "disposition": 0,
                                   "displayed": False,
                                   "payloads": [{"content_type": 1, "text": " ".join(rest[2:]), "bytes": 1}]})
        event("mcdata_sds_received", message_id=mid, **{"from": rest[0]}, group=rest[1], disposition=0)
    elif verb == "fake-file":
        mid = str(uuid.uuid4())
        st["mcdata_files"].append({"message_id": mid, "conversation_id": str(uuid.uuid4()), "from": rest[0],
                                   "group": "", "name": rest[1], "size": 42, "mandatory": False,
                                   "state": "offered"})
        event("mcdata_file_offered", message_id=mid, **{"from": rest[0]}, group="", mandatory=False)
    elif verb == "fake-read":
        st["mcdata_notifications"].append({"from": "x", "group": "", "type": 3, "message_id": rest[0]})
    elif verb == "fake-alias-outcome":
        fake["alias_outcome"] = rest[0]
    elif verb == "fake-lose-alias":
        st["mcdata_functional_aliases"] = [a for a in st["mcdata_functional_aliases"] if a != rest[0]]
    elif verb == "fake-forget":
        st["mcdata_inbox"] = [m for m in st["mcdata_inbox"] if m["message_id"] != rest[0]]
    else:
        failure("unknown client command")


signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
if os.path.exists(fifo):
    os.remove(fifo)
os.mkfifo(fifo, 0o600)
save()
live = cfg.get("mcvideo", {}).get("live")
if live:
    threading.Thread(target=read_pictures, args=(live["fifo"], live["width"] * live["height"] * 3 // 2),
                     daemon=True).start()
control = os.fdopen(os.open(fifo, os.O_RDWR), "r")
for line in control:
    line = line.strip()
    if line:
        with lock:
            command(line)
            save()
